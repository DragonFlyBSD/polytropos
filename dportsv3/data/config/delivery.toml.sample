# DeltaPorts agentic delivery — Step 11d configuration.
#
# THIS FILE IS A TEMPLATE. Nothing loads it. Copy it to
# delivery.toml and edit the copy:
#
#     cp dportsv3/data/config/delivery.toml.sample config/delivery.toml
#
# The tracker looks in exactly two places, in order:
#   1. $DPORTSV3_DELIVERY_CONFIG (explicit path), then
#   2. $DPORTSV3_CONFIG_DIR/delivery.toml
#
# Neither resolving means delivery is disabled: Accept stays a pure
# tracker-side action and logs skip_reason=no_config. There is no
# fallback to this sample, deliberately — a delivery config names one
# repo, one local clone and one credential, so no shipped value could
# be right for a host nobody configured.
#
# The only env-var input is the GitHub token (it's a secret and
# doesn't belong in a committable file):
#   1. $DPORTSV3_DELIVERY_TOKEN env var, then
#   2. $DPORTSV3_CONFIG_DIR/delivery.token
#
# The token file must be readable by whoever runs the tracker — that
# is the process that delivers. On a packaged install that is the
# unprivileged service account, so 0640 root:<service group>, not
# 0400 root. clone_dir must be writable by that same account.
# local-patch never needs a token.

[provider]
# One of: "github" | "gitlab" | "gitea" | "local-patch".
# local-patch writes the diff to provider.outbox instead of
# pushing — handy as a no-network smoke test before flipping to
# a real provider.
type = "github"

# "owner/name" for github/gitlab/gitea. Required unless type =
# "local-patch".
repo = "DragonFlyBSD/DeltaPorts"

# Local DeltaPorts checkout the tracker pushes from. Must be:
#   - a real git working tree
#   - clean (no staged/unstaged changes)
#   - on `base_branch` (the tracker resets onto it per delivery)
#   - have its `origin` remote authorized to push (HTTPS via the
#     token, or SSH via a deploy key)
# Required for network providers; ignored by local-patch.
clone_dir = "/home/you/s/DeltaPorts"

# Branch the PR targets on the upstream remote.
base_branch = "master"

# Open the PR as draft so the operator un-drafts after manual review.
draft = true

# Labels applied best-effort after PR creation. Label-apply failures
# never fail the delivery (the PR is the load-bearing artifact).
labels = ["agentic-fix", "needs-review"]

# Template for the local feature branch + remote head. Placeholders:
#   {origin_safe}    — origin with '/' → '-' (devel-foo)
#   {bundle_short}   — first 8 chars of bundle_id
#   {bundle_id}      — full bundle id
#   {target}         — quarter target (@2026Q2)
branch_template = "agentic/{origin_safe}-{bundle_short}"

# Commit author/committer identity for the delivered fix (also used
# for the Signed-off-by trailer). Applied per-invocation via
# `git -c`, never written to the clone's git config. Defaults shown.
committer_name = "Fred [bot]"
committer_email = "github@dragonflybsd.org"

# Required for type="local-patch" only: directory where patches
# get written. Ignored by network providers.
# outbox = "/var/spool/dports-delivery"


# Optional per-target overrides. The section name must match the
# target value on the bundle exactly, including the leading '@'.
# Any field omitted here falls back to [provider] above.
#
# [target."@2026Q2"]
# base_branch = "2026Q2"
# repo = "DragonFlyBSD/DeltaPorts-2026Q2"
# clone_dir = "/srv/dports-clone-2026Q2"
# labels = ["agentic-fix", "needs-review", "2026Q2"]
