#!/usr/bin/env python3
"""Thin shim — the runner lives in dportsv3.agent.runner.

Kept as a sibling script for operators who want to invoke
``./scripts/agent-queue-runner --queue-root ...`` directly without
going through the ``dportsv3`` CLI.
"""

from __future__ import annotations

import sys
from pathlib import Path

# The repository root is this script's parent directory, and it holds the
# `dportsv3` package. Adding it lets an operator run this shim straight out
# of a checkout without installing anything; an installed copy finds the
# package on sys.path already and this is a no-op.
_REPO_ROOT = Path(__file__).resolve().parents[1]
if (_REPO_ROOT / "dportsv3").is_dir() and str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from dportsv3.agent.runner import main

if __name__ == "__main__":
    sys.exit(main())
