#!/usr/bin/env python3
"""Standalone entry point for the artifact-store HTTP service.

All logic lives in ``dportsv3.artifact_store``; this shim only:
- Bootstraps sys.path so the package is importable from a checkout.
  plain script (no need to activate the generator venv).
- Hands control to ``main()``.

Both invocations are functionally identical:
    ./scripts/artifact-store --logs-root /path
    python -m dportsv3.artifact_store --logs-root /path
"""
from __future__ import annotations

import sys
from pathlib import Path

# Same bootstrap pattern as bin/agent-queue-runner: the repository root is
# this script's parent directory and holds the `dportsv3` package, so an
# operator can run this straight out of a checkout. For an installed copy the
# package is already importable and this is a no-op.
_REPO_ROOT = Path(__file__).resolve().parents[1]
if (_REPO_ROOT / "dportsv3").is_dir() and str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from dportsv3.artifact_store import main  # noqa: E402

if __name__ == "__main__":
    main()
