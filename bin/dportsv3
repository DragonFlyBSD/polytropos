#!/bin/sh

set -eu

# This wrapper ships inside the checkout, so it is the one component entitled
# to know the repository layout — which is precisely what keeps that knowledge
# out of the Python packages, where it used to live as parents[N] walks.
SELF_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
GENERATOR_DIR="$SELF_DIR"
VENV_DIR="$GENERATOR_DIR/.venv"
STAMP_FILE="$VENV_DIR/.dportsv3-install-stamp"
PYPROJECT_FILE="$GENERATOR_DIR/pyproject.toml"
PYTHON_BIN=${PYTHON:-python3}
DEV_ENV_DIR="$SELF_DIR/dev-env"
DEV_ENV_VENV_DIR="$DEV_ENV_DIR/.venv"
DEV_ENV_STAMP_FILE="$DEV_ENV_VENV_DIR/.dports-dev-env-install-stamp"
DEV_ENV_PYPROJECT_FILE="$DEV_ENV_DIR/pyproject.toml"
DEV_ENV_LOCK_DIR="$DEV_ENV_DIR/.venv.lock"

# Point the tool at the checkout's config/ unless the operator has chosen a
# directory themselves. Everything downstream resolves config through
# $DPORTSV3_CONFIG_DIR, so setting it here is what makes a plain `git clone`
# behave like a configured install without any code guessing at paths.
#
# Only when that directory actually holds configuration, though. config/
# ships empty on purpose, and claiming an empty one used to mask a real
# install: on a host with both a checkout and /usr/local/etc/polytropos,
# this variable pointed at a directory with no polytropos.toml, so the
# settings file nobody had edited won over the one the operator had, and
# every value silently came from the table defaults (poly-mrl). Leaving
# it unset lets paths.config_dir() search the conventional locations.
if [ -z "${DPORTSV3_CONFIG_DIR:-}" ] &&
   { [ -f "$SELF_DIR/config/polytropos.toml" ] ||
     [ -d "$SELF_DIR/config/secrets" ]; }; then
    DPORTSV3_CONFIG_DIR="$SELF_DIR/config"
    export DPORTSV3_CONFIG_DIR
fi

# Same idea for the dev-env manager: a chroot now holds two checkouts, the
# ports tree and this tool, and the tool checkout cannot be inferred from
# inside a package without the parents[N] walk the split exists to remove.
# This wrapper knows where it lives, so it says so; `dev-env create` falls
# back to this variable when no --tool-root is given.
if [ -z "${DPORTS_DEV_TOOL_ROOT:-}" ]; then
    DPORTS_DEV_TOOL_ROOT="$SELF_DIR"
    export DPORTS_DEV_TOOL_ROOT
fi

# Tell the agent how to re-invoke this wrapper. It shells out to
# `dportsv3 dev-env exec ...`, and this script is the only entry point that
# routes `dev-env` — the console script of the same name does not implement
# it. Exporting our own path means the agent never has to search, and never
# finds the console script by mistake.
if [ -z "${DPORTSV3_CMD:-}" ]; then
    DPORTSV3_CMD="$SELF_DIR/bin/dportsv3"
    export DPORTSV3_CMD
fi

if [ ! -f "$PYPROJECT_FILE" ]; then
    printf '%s\n' "dportsv3: missing generator project: $PYPROJECT_FILE" >&2
    exit 1
fi

if [ "${DPORTSV3_NO_BOOTSTRAP:-0}" = "1" ]; then
    AUTO_BOOTSTRAP=0
else
    AUTO_BOOTSTRAP=1
fi

show_help() {
    cat <<'EOF'
usage: dportsv3 COMMAND ...

DeltaPorts v3 tooling

wrapper commands:
  dev-env         Manage disposable DragonFly chroot development environments

generator commands:
  compose         Compose full target output tree
  compose-report  Summarize compose JSON report for humans/tools
  dsl             DSL parse/check/plan commands
  migrate         Migration utilities (compose-first workflow)
  tracker            Build tracker server and queries
  agent-queue-runner Run the agent queue runner (triage + patch loop)

Use 'dportsv3 COMMAND --help' for command-specific help.
EOF
}

case "${1:-}" in
    ""|-h|--help|help)
        show_help
        exit 0
        ;;
esac

INSTALL_PROFILE=base
INSTALL_TARGET=$GENERATOR_DIR
if [ "${1:-}" = "tracker" ] && [ "${2:-}" = "serve" ]; then
    INSTALL_PROFILE=tracker
    INSTALL_TARGET="$GENERATOR_DIR[tracker]"
fi

command -v "$PYTHON_BIN" >/dev/null 2>&1 || {
    printf '%s\n' "dportsv3: required interpreter not found: $PYTHON_BIN" >&2
    exit 1
}

compute_dev_env_stamp() {
    "$PYTHON_BIN" - "$DEV_ENV_DIR" <<'PY'
from __future__ import annotations

import hashlib
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
digest = hashlib.sha256()
for path in [root / "pyproject.toml", *sorted((root / "dports_dev_env").rglob("*.py"))]:
    digest.update(str(path.relative_to(root)).encode())
    digest.update(b"\0")
    digest.update(path.read_bytes())
    digest.update(b"\0")
print(digest.hexdigest())
PY
}

runtime_profile_packages() {
    "$PYTHON_BIN" - "$DEV_ENV_DIR/dports_dev_env/runtime-profiles.toml" <<'PY'
from __future__ import annotations

import os
import pathlib
import sys
import tomllib

data = tomllib.loads(pathlib.Path(sys.argv[1]).read_text())
name = os.environ.get("DPORTS_DEV_RUNTIME_PROFILE") or data["default"]
print(" ".join(data["profiles"][name]["packages"]))
PY
}

if [ "${1:-}" = "dev-env" ]; then
    shift
    if [ ! -f "$DEV_ENV_PYPROJECT_FILE" ]; then
        printf '%s\n' "dportsv3: missing dev-env project: $DEV_ENV_PYPROJECT_FILE" >&2
        exit 1
    fi
    DEV_ENV_STAMP_VALUE=$(compute_dev_env_stamp)
    dev_env_needs_install=0
    if [ ! -x "$DEV_ENV_VENV_DIR/bin/dports-dev-env" ]; then
        dev_env_needs_install=1
    elif [ ! -f "$DEV_ENV_STAMP_FILE" ]; then
        dev_env_needs_install=1
    elif [ "$(cat "$DEV_ENV_STAMP_FILE")" != "$DEV_ENV_STAMP_VALUE" ]; then
        dev_env_needs_install=1
    fi
    if [ "$dev_env_needs_install" -eq 1 ]; then
        waited=0
        while ! mkdir "$DEV_ENV_LOCK_DIR" 2>/dev/null; do
            if [ "$waited" -ge 300 ]; then
                printf '%s\n' "dportsv3: timed out waiting for dev-env bootstrap lock: $DEV_ENV_LOCK_DIR" >&2
                exit 1
            fi
            sleep 1
            waited=$((waited + 1))
        done
        trap 'rmdir "$DEV_ENV_LOCK_DIR" 2>/dev/null || true' EXIT INT TERM HUP
        dev_env_needs_install=0
        if [ ! -x "$DEV_ENV_VENV_DIR/bin/dports-dev-env" ]; then
            dev_env_needs_install=1
        elif [ ! -f "$DEV_ENV_STAMP_FILE" ]; then
            dev_env_needs_install=1
        elif [ "$(cat "$DEV_ENV_STAMP_FILE")" != "$DEV_ENV_STAMP_VALUE" ]; then
            dev_env_needs_install=1
        fi
    fi
    if [ "$dev_env_needs_install" -eq 1 ]; then
        if [ "$AUTO_BOOTSTRAP" -ne 1 ]; then
            printf '%s\n' "dportsv3: dev-env bootstrap required but DPORTSV3_NO_BOOTSTRAP=1" >&2
            exit 1
        fi
        if [ ! -d "$DEV_ENV_VENV_DIR" ]; then
            printf '%s\n' "dportsv3: creating dev-env virtual environment at $DEV_ENV_VENV_DIR" >&2
            "$PYTHON_BIN" -m venv "$DEV_ENV_VENV_DIR"
        fi
        printf '%s\n' "dportsv3: installing dev-env tool" >&2
        "$DEV_ENV_VENV_DIR/bin/python" -m pip install -e "$DEV_ENV_DIR"
        printf '%s\n' "$DEV_ENV_STAMP_VALUE" > "$DEV_ENV_STAMP_FILE"
    fi
    rmdir "$DEV_ENV_LOCK_DIR" 2>/dev/null || true
    trap - EXIT INT TERM HUP
    exec "$DEV_ENV_VENV_DIR/bin/dports-dev-env" "$@"
fi

compute_stamp() {
    "$PYTHON_BIN" - "$PYPROJECT_FILE" "$INSTALL_PROFILE" <<'PY'
from __future__ import annotations

import hashlib
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
profile = sys.argv[2]
digest = hashlib.sha256(path.read_bytes()).hexdigest()
print(f"{profile}:{digest}")
PY
}

# The generator venv now contains dev-env too, so a dev-env source change has
# to invalidate this venv as well — otherwise the generator keeps running
# against a stale editable copy of its own dependency.
STAMP_VALUE="$(compute_stamp)+$(compute_dev_env_stamp)"

# The `tracker` profile installs everything `base` does plus the extra, so a
# venv stamped tracker already satisfies a base request. Without this the two
# profiles evict each other: bootstrapping `tracker serve` records "tracker:",
# after which a base-profile command sees a mismatch and — under
# DPORTSV3_NO_BOOTSTRAP=1, which is how the rc.d services run — refuses to
# start against a venv that can run it perfectly well. Found bringing the
# services up on hardware. The relation is one-way: base does not
# satisfy tracker.
stamp_satisfied() {
    [ "$1" = "$2" ] && return 0
    if [ "$INSTALL_PROFILE" = "base" ] && [ "$1" = "tracker:${2#base:}" ]; then
        return 0
    fi
    return 1
}

needs_install=0
if [ ! -x "$VENV_DIR/bin/dportsv3" ]; then
    needs_install=1
elif [ ! -f "$STAMP_FILE" ]; then
    needs_install=1
elif ! stamp_satisfied "$(cat "$STAMP_FILE")" "$STAMP_VALUE"; then
    needs_install=1
fi

if [ "$needs_install" -eq 1 ]; then
    if [ "$AUTO_BOOTSTRAP" -ne 1 ]; then
        printf '%s\n' "dportsv3: bootstrap required but DPORTSV3_NO_BOOTSTRAP=1" >&2
        exit 1
    fi

    if [ "$(uname -s)" = "DragonFly" ]; then
        REQUIRED_DFLY_PKGS=$(runtime_profile_packages)
        missing_pkgs=
        for p in $REQUIRED_DFLY_PKGS; do
            pkg info -e "$p" >/dev/null 2>&1 || missing_pkgs="$missing_pkgs $p"
        done
        if [ -n "$missing_pkgs" ]; then
            printf '%s\n' "dportsv3: missing DragonFly packages required for the generator/tracker venv:" >&2
            printf '%s\n' "  pkg install$missing_pkgs" >&2
            printf '%s\n' "These satisfy pydantic / fastapi / uvicorn[standard] without pulling Rust-built wheels." >&2
            printf '%s\n' "Re-run dportsv3 after installing." >&2
            exit 1
        fi
    fi

    if [ ! -d "$VENV_DIR" ]; then
        printf '%s\n' "dportsv3: creating virtual environment at $VENV_DIR" >&2
        "$PYTHON_BIN" -m venv --system-site-packages "$VENV_DIR"
    fi

    # The generator declares `dports-dev-env` as a dependency (it resolves
    # and health-probes envs through that package). It is a sibling source
    # tree, not a PyPI distribution, so install it FIRST: pip then sees the
    # requirement already satisfied and never reaches for an index. Order
    # matters — reverse it and the generator install fails resolving a name
    # that does not exist upstream.
    printf '%s\n' "dportsv3: installing dev-env (generator dependency)" >&2
    "$VENV_DIR/bin/python" -m pip install -e "$DEV_ENV_DIR"

    printf '%s\n' "dportsv3: installing generator ($INSTALL_PROFILE)" >&2
    "$VENV_DIR/bin/python" -m pip install -e "$INSTALL_TARGET"
    printf '%s\n' "$STAMP_VALUE" > "$STAMP_FILE"
fi

exec "$VENV_DIR/bin/dportsv3" "$@"
