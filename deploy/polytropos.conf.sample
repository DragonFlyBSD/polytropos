# Shared configuration for the Polytropos services.
#
# Installed as /usr/local/etc/polytropos.conf and sourced by all three
# rc.d scripts. Every setting uses the `: ${var:="value"}` form, which
# assigns only when the variable is unset — so the precedence is:
#
#     /etc/rc.conf   (highest — rc.subr reads it before this file)
#     this file
#     the rc.d script's own defaults (lowest)
#
# Credentials do NOT belong here: this file is world-readable. See
# /usr/local/etc/polytropos/harness.env instead.

# The commands the services run. Not a repository path: these are two
# entry points, and where they come from is nobody's business but the
# operator's. A packaged install has both in the prefix bindir.
#
# From a git checkout, point them at the wrapper instead:
#
#     : ${polytropos_cmd:="/home/you/polytropos/bin/dportsv3"}
#     : ${polytropos_dev_env_cmd:="/home/you/polytropos/bin/dportsv3 dev-env"}
#
# The wrapper is the entry point that knows the repository layout — it
# exports DPORTSV3_CONFIG_DIR, DPORTS_DEV_TOOL_ROOT and DPORTSV3_CMD for
# everything downstream, and it builds the venv on demand. The packaged
# console scripts need none of that.
: ${polytropos_cmd:="/usr/local/bin/dportsv3"}

# Only the runner uses this one: it is how the agent reaches a chroot.
# The `dportsv3` console script deliberately does NOT implement `dev-env`,
# so this must be dports-dev-env (or a checkout wrapper plus that word).
: ${polytropos_dev_env_cmd:="/usr/local/bin/dports-dev-env"}

# PATH for the services. rc.subr's own PATH leaves out the local prefix,
# which is where python3 and dports-dev-env live on DragonFly — without
# this the checkout wrapper cannot find an interpreter at all.
: ${polytropos_path:="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}

# The unprivileged account that owns the evidence tree and runs the two
# HTTP services. The queue runner ignores this and runs as root, because
# dev-env requires it.
: ${polytropos_user:="polytropos"}
: ${polytropos_group:="polytropos"}

# HOME for the two services that drop privileges. `daemon -u` lowers the
# uid but leaves HOME inherited from root, so it has to be said here or
# they run with HOME=/root and cannot read it.
: ${polytropos_home:="/var/db/polytropos"}

# The one path everything else is derived from.
: ${polytropos_logs_root:="/build/synth/logs"}

# Derived. Override individually only if your layout differs from the
# one the dsynth hooks and OPERATOR_SETUP.md assume.
: ${polytropos_state_db:="${polytropos_logs_root}/evidence/state.db"}
: ${polytropos_artifact_root:="${polytropos_logs_root}/evidence"}
: ${polytropos_queue_root:="${polytropos_logs_root}/evidence/queue"}

# Service output. daemon(8) appends each service's stdout/stderr here.
# Nothing rotates these yet — see poly-abr.4. The pidfiles are already in
# place, which is what a newsyslog entry will need.
: ${polytropos_log_dir:="/var/log/polytropos"}

# --- listeners ---------------------------------------------------------
#
# The tracker has no authentication and its API can start builds and
# spend LLM credit. 0.0.0.0 is a deliberate choice for a trusted network.
# Set 127.0.0.1 and use `ssh -L 8080:localhost:8080 buildbox` if that is
# not your situation.
: ${polytropos_tracker_bind:="0.0.0.0"}
: ${polytropos_tracker_port:="8080"}

# The artifact store only ever receives bundles from hooks on this host.

# How the runner reaches the other two. Keep in step with the ports above.
: ${polytropos_tracker_url:="http://127.0.0.1:8080"}

# Where the tool looks for its own config files. Both services export
# this as $DPORTSV3_CONFIG_DIR, which is the only way anything in the
# Python packages finds a config file at all — nothing searches for a
# surrounding directory.
#
# What lives here:
#   agentic-policy.json  classification + confidence -> tier and budget.
#                        Optional: absent falls back to the packaged
#                        default, which is a usable policy.
#   delivery.toml        what Accept does with a fix. Absent means
#                        delivery is off. Copy delivery.toml.sample and
#                        edit it to turn it on; there is no fallback,
#                        because no shipped value could name the right
#                        repo, clone and credential for this host.
#   delivery.token       the forge credential, when delivery.toml uses a
#                        network provider. Mode 0640 root:${polytropos_group}
#                        — the TRACKER delivers, and it runs
#                        unprivileged, so a 0400 root token is
#                        unreadable by the only process that wants it.
: ${polytropos_config_dir:="/usr/local/etc/polytropos"}

# --- runner ------------------------------------------------------------

# Default dev-env for jobs that do not carry one and when the tracker has
# no active env recorded. Leave empty on a single-env host: the runner
# auto-picks when exactly one exists. With several envs and nothing set,
# the runner holds rather than running with the dsynth-busy gate off.
: ${polytropos_runner_dev_env:=""}

# Where the LLM credentials live. Mode 600, root-owned.
: ${polytropos_harness_env:="/usr/local/etc/polytropos/harness.env"}
