# Upstream delivery for the tracker: what Accept does with a fix.
#
# Installed as /usr/local/etc/polytropos/delivery.toml.sample, owned
# root:${polytropos_group}, mode 0640.
#
# THIS FILE IS A TEMPLATE AND NOTHING LOADS IT. Delivery stays off
# until you copy it into place:
#
#     cp delivery.toml.sample delivery.toml
#     $EDITOR delivery.toml
#
# The tracker looks in exactly two places, in order:
#   1. $DPORTSV3_DELIVERY_CONFIG (explicit path), then
#   2. $DPORTSV3_CONFIG_DIR/delivery.toml
#
# The rc scripts set DPORTSV3_CONFIG_DIR from polytropos_config_dir in
# /usr/local/etc/polytropos.conf, which points here by default. With no
# delivery.toml, Accept logs skip_reason=no_config and changes nothing
# outside the tracker. There is no fallback to this sample: a delivery
# config names one repo, one local clone and one credential, so no
# shipped value could be right for a host nobody configured.
#
# --- who runs this ----------------------------------------------------
#
# Delivery happens inside the TRACKER, not the queue runner, and the
# tracker drops to ${polytropos_user}. So both of these have to be
# reachable by that account, not by root:
#
#   - the token file          0640 root:${polytropos_group}
#   - provider.clone_dir      writable by ${polytropos_user}
#
# Same reasoning as chat.env being 0640 while harness.env is 0600: the
# mode follows the reader, and the reader here is unprivileged.

[provider]

# One of: "github" | "gitlab" | "gitea" | "local-patch".
#
# Start with local-patch. It writes the diff to provider.outbox instead
# of pushing anywhere, which proves the whole Accept path end to end
# with no credentials and no network. Switch to github once you have
# seen a patch land in the outbox.
type = "local-patch"

# Required for type="local-patch": where the patches get written. Must
# be writable by ${polytropos_user}.
outbox = "/var/spool/polytropos-delivery"

# --- everything below applies to type="github" ------------------------

# "owner/name". Required unless type = "local-patch".
#repo = "DragonFlyBSD/DeltaPorts"

# The local DeltaPorts checkout the tracker pushes from. Must be:
#   - a real git working tree
#   - clean (no staged or unstaged changes)
#   - on base_branch (the tracker resets onto it per delivery)
#   - writable by ${polytropos_user}
#   - with an origin remote authorized to push (HTTPS via the token,
#     or SSH via a deploy key belonging to that account)
#
# The tracker checks all of this at startup and logs what is wrong,
# rather than waiting for the first Accept to find out.
#clone_dir = "/var/db/polytropos/DeltaPorts"

# Branch the PR targets upstream.
#base_branch = "master"

# Open as a draft so a human un-drafts after review.
#draft = true

# Applied best-effort after the PR exists. A label failure never fails
# the delivery — the PR is the load-bearing artifact.
#labels = ["agentic-fix", "needs-review"]

# Template for the local branch and the remote head. Placeholders:
#   {origin_safe}       origin with '/' -> '-'  (devel-foo)
#   {target_safe}       target without the leading '@'
#   {signature_short}   first 8 chars of the error signature
#   {bundle_short}      trailing 16 chars of the bundle id
#   {bundle_id}         the full bundle id
#
# The default keys on the error signature so retries against the same
# (origin, target, root cause) converge on one branch and one PR.
#branch_template = "agentic/{origin_safe}-{target_safe}-{signature_short}"

# Commit author and committer for the delivered fix, and the
# Signed-off-by trailer. Applied per invocation with `git -c`, never
# written into the clone's git config. Defaults shown.
#committer_name = "Fred [bot]"
#committer_email = "github@dragonflybsd.org"


# Optional per-target overrides. The section name must match the
# bundle's target exactly, including the leading '@'. Any field omitted
# here falls back to [provider] above.
#
#[target."@2026Q2"]
#base_branch = "2026Q2"
#repo = "DragonFlyBSD/DeltaPorts-2026Q2"
#clone_dir = "/var/db/polytropos/DeltaPorts-2026Q2"
#labels = ["agentic-fix", "needs-review", "2026Q2"]
