# LLM credentials for the queue runner.
#
# Installed as /usr/local/etc/polytropos/harness.env, owned by root,
# mode 0600. The runner is the only consumer and it runs as root, so
# ${polytropos_user} never needs to read this file.
#
# Sourced by the rc script, so every line must be a shell `export`.

# Triage: cheap and fast, called on every failure.
export DP_HARNESS_TRIAGE_MODEL="deepseek/deepseek-v4-flash"
export DP_HARNESS_TRIAGE_API_KEY="replace-me"
#export DP_HARNESS_TRIAGE_PROVIDER=""
#export DP_HARNESS_TRIAGE_API_BASE=""

# Patch: the expensive one. Falls back to the triage model when unset.
export DP_HARNESS_PATCH_MODEL="deepseek/deepseek-v4-pro"
export DP_HARNESS_PATCH_API_KEY="replace-me"
#export DP_HARNESS_PATCH_PROVIDER=""
#export DP_HARNESS_PATCH_API_BASE=""

# Optional limits. The defaults live in the code; set these only to
# override them.
#export DP_HARNESS_MAX_PATCH_ATTEMPTS="3"
#export DP_HARNESS_MAX_SNIPPET_ROUNDS="4"
#export DP_HARNESS_TIMEOUT="600"
