# LLM credentials for the tracker's fix-chat panel.
#
# Installed as /usr/local/etc/polytropos/chat.env, owned root:${polytropos_group},
# mode 0640 — the tracker runs as the unprivileged service user and has
# to read it, which is why this is a separate file from the runner's
# harness.env rather than a section of it.
#
# The whole feature is gated on DP_HARNESS_CHAT_MODEL: leave this file
# absent, or the variable unset, and the chat endpoint answers 503 and
# the UI panel stays hidden. Nothing else breaks.
#
# Sourced by the rc script, so every line must be a shell `export`.

export DP_HARNESS_CHAT_MODEL="deepseek/deepseek-v4-pro"
export DP_HARNESS_CHAT_API_KEY="replace-me"
#export DP_HARNESS_CHAT_PROVIDER=""
#export DP_HARNESS_CHAT_API_BASE=""
#export DP_HARNESS_CHAT_TIMEOUT="120"
