#!/bin/sh

# PROVIDE: polytropos_runner
# REQUIRE: LOGIN FILESYSTEMS polytropos_tracker
# KEYWORD: shutdown

#
# The agent queue runner: claims jobs written by the dsynth hooks and
# runs triage/patch against a dev-env.
#
# This one runs as ROOT and must. Every `dev-env` subcommand calls
# require_root(), and a non-root runner refuses to start with exit 4
# rather than running with the dsynth-busy gate switched off. Do not
# add polytropos_user here.
#
# Because it runs as root while the rest of the tree belongs to
# ${polytropos_user}, it starts with umask 002 so the files it creates
# stay group-writable for the two unprivileged services.
#
# Add the following line to /etc/rc.conf to enable it:
# polytropos_runner_enable="YES"
#
# Knobs (see /usr/local/etc/polytropos.conf for the shared ones):
# polytropos_runner_enable   (bool) Set to "NO" by default.
# polytropos_cmd             (str)  The dportsv3 command to run.
# polytropos_dev_env_cmd     (str)  The dports-dev-env command it uses to
#                                   reach a chroot.
# polytropos_config_dir      (str)  Where polytropos.toml and secrets/ live.
#                                   Everything else this service needs is IN
#                                   polytropos.toml — the queue root, the
#                                   models, the attempt limits, the policy.
#                                   `dportsv3 config show` prints the lot.
#

. /etc/rc.subr

name="polytropos_runner"
rcvar=polytropos_runner_enable
desc="Polytropos agent queue runner"

load_rc_config $name

: ${polytropos_runner_enable:="NO"}
: ${polytropos_conf:="/usr/local/etc/polytropos.conf"}
[ -r "${polytropos_conf}" ] && . "${polytropos_conf}"

: ${polytropos_cmd:="/usr/local/bin/dportsv3"}

# rc.subr runs with a PATH that does not include the local prefix, and on
# DragonFly that is where python3 lives. The checkout wrapper looks up
# `python3` and dies with "required interpreter not found"; the runtime
# looks up `dports-dev-env` the same way.
: ${polytropos_path:="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}
PATH="${polytropos_path}"
export PATH
: ${polytropos_dev_env_cmd:="/usr/local/bin/dports-dev-env"}
: ${polytropos_log_dir:="/var/log/polytropos"}
: ${polytropos_config_dir:="/usr/local/etc/polytropos"}

# $pidfile is the SUPERVISOR's, and has to be. rc.subr matches the pid it
# finds there against $procname, which defaults to $command — that is
# /usr/sbin/daemon, not the Python process daemon spawns. Point it at the
# child and `service status` calls a running service stopped, and `stop`
# cannot find it either.
#
# Stopping the supervisor is also the correct thing to do: daemon(8)
# forwards SIGTERM to its child, which exits and takes the supervisor
# with it.
#
# newsyslog uses this same pidfile, for a different reason — only the
# supervisor reopens the output file on SIGUSR1. Sending SIGUSR1 to the
# child, which daemon(8)'s own rotation advice reads like, kills it:
# measured on DragonFly, service and supervisor both went away.
pidfile="/var/run/${name}.pid"

# The worker's own pid, for an operator who wants to look at it. Nothing
# in rc or newsyslog reads this.
child_pidfile="/var/run/${name}.child.pid"
logfile="${polytropos_log_dir}/runner.log"

# NOTE: ${name}_env is rc.subr's own knob for the child environment.
#
# Two variables, and neither is configuration: NO_BOOTSTRAP tells the
# wrapper this is a service rather than a developer, and CONFIG_DIR names
# the settings file and so cannot live inside it. The state database, the
# tracker URL and the default dev-env used to be here too, translated
# from polytropos.conf one variable at a time; they are settings now.
polytropos_runner_env="DPORTSV3_NO_BOOTSTRAP=1 \
DPORTSV3_CONFIG_DIR=${polytropos_config_dir}"

# No `daemon -r`, deliberately, and not for lack of precedent: ports such
# as net-mgmt/bosun and net-mgmt/telegraf run `daemon -fcr -P ...` and
# supervise. It is wrong here. -r restarts the child whatever the exit
# code, and this program uses exit 3 (another runner holds the lock) and
# exit 4 (dev-env store unreadable) as configuration signals. Supervising
# those spins at one restart a second instead of surfacing them.
#
# Note for anyone adding -r later: it must come with -P, not -p. rc.subr
# signals whatever is in $pidfile, and with -p that is the child — the
# supervisor would simply restart it. The ports above use -P for exactly
# this reason.
command="/usr/sbin/daemon"
# No --queue-root and no --env: paths.queue_root and runner.dev_env are
# settings. Both flags still exist for an operator running this by hand.
command_args="-c -f -o ${logfile} -p ${child_pidfile} -P ${pidfile} -t ${name} \
    ${polytropos_cmd} agent-queue-runner"

start_precmd="polytropos_runner_prestart"

polytropos_runner_prestart()
{
	if ! command -v "${polytropos_cmd}" >/dev/null 2>&1; then
		err 1 "${polytropos_cmd} not found; set polytropos_cmd — a packaged install has it in the prefix bindir, a checkout at bin/dportsv3"
	fi

	# Probe with the service's own argv. In a checkout this also catches
	# a stale install stamp, which bin/dportsv3 compares on every run and
	# turns into exit 1 under DPORTSV3_NO_BOOTSTRAP=1; in a packaged
	# install there is no venv to be stale and this simply proves the
	# command runs. Same check, both worlds.
	if ! DPORTSV3_NO_BOOTSTRAP=1 "${polytropos_cmd}" \
	    agent-queue-runner --help >/dev/null 2>&1; then
		err 1 "${polytropos_cmd} does not run; in a checkout the venv is stale or missing — try: ${polytropos_cmd} agent-queue-runner --help"
	fi

	# The dev-env entry point is a SEPARATE distribution with its own
	# venv and its own install stamp, and this process reaches a chroot
	# from 21 different functions. A stale one does not fail once, it
	# fails every job, with the reason buried in per-job output.
	if ! DPORTSV3_NO_BOOTSTRAP=1 ${polytropos_dev_env_cmd} \
	    --help >/dev/null 2>&1; then
		err 1 "${polytropos_dev_env_cmd} does not run; set polytropos_dev_env_cmd — try: ${polytropos_dev_env_cmd} --help"
	fi

	# Ask the tool where the queue is rather than keeping a second copy
	# of the path in polytropos.conf. One exec at service start, and no
	# way for the two to disagree — which they would, silently, the first
	# time someone changed paths.queue_root and not the shell variable.
	_queue_root=$(DPORTSV3_NO_BOOTSTRAP=1 \
	    DPORTSV3_CONFIG_DIR="${polytropos_config_dir}" \
	    "${polytropos_cmd}" config get paths.queue_root 2>/dev/null)
	if [ -z "${_queue_root}" ]; then
		err 1 "could not read paths.queue_root; try: ${polytropos_cmd} config check"
	fi

	# The runner requires the four subdirectories to exist and exits 1
	# naming the missing one, so create them rather than fail at start.
	for _d in pending inflight done failed; do
		install -d -m 0775 "${_queue_root}/${_d}" || return 1
	done
	install -d -m 0755 "${polytropos_log_dir}" || return 1

	# Nothing is sourced here any more. This used to read a shell file of
	# shell exports, because os.environ was the only channel
	# a setting had into the Python. Credentials live one per file under
	# secrets/ now, and the runner reads them itself.
	if ! DPORTSV3_NO_BOOTSTRAP=1 DPORTSV3_CONFIG_DIR="${polytropos_config_dir}" \
	    "${polytropos_cmd}" config check >/dev/null 2>&1; then
		warn "settings in ${polytropos_config_dir} did not validate; run: ${polytropos_cmd} config check"
	fi

	# Exported here rather than through ${name}_env, which rc.subr
	# word-splits: from a checkout this value is two words
	# ("<wrapper> dev-env") and `env` takes the second as the command to
	# run, failing with "env: dev-env: No such file or directory".
	# start_precmd is eval'd in this shell, so the export reaches the
	# child with the spaces intact.
	DPORTS_DEV_ENV_CMD="${polytropos_dev_env_cmd}"
	export DPORTS_DEV_ENV_CMD

	# Root writing into a tree owned by ${polytropos_user}: without this
	# the tracker cannot write the files this process creates, and it
	# writes the blobstore now too. The failure looks like a
	# read-only database, not a
	# permission error.
	umask 002
}

run_rc_command "$1"
