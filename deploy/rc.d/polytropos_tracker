#!/bin/sh

# PROVIDE: polytropos_tracker
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown

#
# The build tracker: web UI, read API and SSE.
#
# WARNING: the tracker has no authentication, and its API can start
# builds and spend LLM credit. It binds every interface by default
# because the dashboard is meant to be opened from your desk. Run it on
# a trusted network, or set polytropos_tracker_bind="127.0.0.1" and
# reach it over an ssh tunnel.
#
# Add the following line to /etc/rc.conf to enable it:
# polytropos_tracker_enable="YES"
#
# Knobs (see /usr/local/etc/polytropos.conf for the shared ones):
# polytropos_tracker_enable (bool)  Set to "NO" by default.
# polytropos_home           (str)   HOME for the service user.
# polytropos_cmd            (str)   The dportsv3 command to run.
# polytropos_tracker_bind   (str)   Listen address. Default 0.0.0.0.
# polytropos_tracker_port   (str)   Listen port. Default 8080.
# polytropos_chat_env       (str)   Credentials for the fix-chat panel.
#                                   Absent means chat is disabled.
# polytropos_config_dir     (str)   Where delivery.toml, delivery.token and
#                                   agentic-policy.json live.
#

. /etc/rc.subr

name="polytropos_tracker"
rcvar=polytropos_tracker_enable
desc="Polytropos build tracker"

load_rc_config $name

: ${polytropos_tracker_enable:="NO"}
: ${polytropos_conf:="/usr/local/etc/polytropos.conf"}
[ -r "${polytropos_conf}" ] && . "${polytropos_conf}"

: ${polytropos_cmd:="/usr/local/bin/dportsv3"}

# rc.subr runs with a PATH that does not include the local prefix, and on
# DragonFly that is where python3 lives. The checkout wrapper looks up
# `python3` and dies with "required interpreter not found"; the runtime
# looks up `dports-dev-env` the same way.
: ${polytropos_path:="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"}
PATH="${polytropos_path}"
export PATH
: ${polytropos_user:="polytropos"}
: ${polytropos_logs_root:="/build/synth/logs"}
: ${polytropos_home:="/var/db/polytropos"}
: ${polytropos_log_dir:="/var/log/polytropos"}
: ${polytropos_state_db:="${polytropos_logs_root}/evidence/state.db"}
: ${polytropos_artifact_root:="${polytropos_logs_root}/evidence"}
: ${polytropos_chat_env:="/usr/local/etc/polytropos/chat.env"}
: ${polytropos_config_dir:="/usr/local/etc/polytropos"}
: ${polytropos_tracker_bind:="0.0.0.0"}
: ${polytropos_tracker_port:="8080"}

# $pidfile is the SUPERVISOR's, and has to be. rc.subr matches the pid it
# finds there against $procname, which defaults to $command — that is
# /usr/sbin/daemon, not the Python process daemon spawns. Point it at the
# child and `service status` calls a running service stopped, and `stop`
# cannot find it either.
#
# Stopping the supervisor is also the correct thing to do: daemon(8)
# forwards SIGTERM to its child, which exits and takes the supervisor
# with it.
#
# newsyslog uses this same pidfile, for a different reason — only the
# supervisor reopens the output file on SIGUSR1. Sending SIGUSR1 to the
# child, which daemon(8)'s own rotation advice reads like, kills it:
# measured on DragonFly, service and supervisor both went away.
pidfile="/var/run/${name}.pid"

# The worker's own pid, for an operator who wants to look at it. Nothing
# in rc or newsyslog reads this.
child_pidfile="/var/run/${name}.child.pid"
logfile="${polytropos_log_dir}/tracker.log"

# HOME is not set by `daemon -u`: verified on DragonFly that a
# child dropped to an unprivileged user still inherits HOME=/root,
# which it cannot read. www/grist-core exports HOME for the same
# reason. Anything using Path.home() or a ~/.cache would fail in a
# way that points nowhere near this file.
polytropos_tracker_env="HOME=${polytropos_home} DPORTSV3_NO_BOOTSTRAP=1 \
DPORTSV3_CONFIG_DIR=${polytropos_config_dir} \
DPORTSV3_STATE_DB=${polytropos_state_db} \
DPORTSV3_ARTIFACT_ROOT=${polytropos_artifact_root}"

command="/usr/sbin/daemon"
command_args="-c -f -o ${logfile} -p ${child_pidfile} -P ${pidfile} -t ${name} -u ${polytropos_user} \
    ${polytropos_cmd} tracker serve \
    --bind ${polytropos_tracker_bind} \
    --port ${polytropos_tracker_port}"

start_precmd="polytropos_tracker_prestart"

polytropos_tracker_prestart()
{
	if ! command -v "${polytropos_cmd}" >/dev/null 2>&1; then
		err 1 "${polytropos_cmd} not found; set polytropos_cmd — a packaged install has it in the prefix bindir, a checkout at bin/dportsv3"
	fi

	# The wrapper compares an install stamp against the venv on every
	# run, and DPORTSV3_NO_BOOTSTRAP=1 turns a mismatch into exit 1
	# rather than an install. Catch that here: otherwise the service
	# starts cleanly and fails at the first request instead.
	#
	# The probe must be `tracker serve`, not `--version`. The install
	# profile is part of the stamp string — bin/dportsv3 records
	# "<profile>:<digest>" and selects INSTALL_PROFILE=tracker only when
	# argv is exactly `tracker serve`. Probing with anything else
	# compares against the base stamp, which is wrong both ways round:
	# it refuses to start on a tracker-profile venv, and it passes on a
	# base-profile venv that `tracker serve` will then reject.
	# `--help` is handled by argparse after the stamp check, so this
	# exits 0 without binding a port.
	if ! DPORTSV3_NO_BOOTSTRAP=1 "${polytropos_cmd}" \
	    tracker serve --help >/dev/null 2>&1; then
		err 1 "${polytropos_cmd} does not run; in a checkout the venv is stale or lacks the [tracker] extra — try: ${polytropos_cmd} tracker serve --help"
	fi
	install -d -o "${polytropos_user}" -m 0755 "${polytropos_log_dir}" || return 1
	install -d -o "${polytropos_user}" -m 0755 "${polytropos_home}" || return 1

	# The fix-chat panel calls an LLM from inside the tracker, so this
	# service needs credentials too — a separate file from the runner's,
	# because this one runs as ${polytropos_user} and must be able to
	# read it. Absent is a supported state: DP_HARNESS_CHAT_MODEL unset
	# disables the feature (503 on the endpoint, panel hidden).
	if [ -r "${polytropos_chat_env}" ]; then
		. "${polytropos_chat_env}"
	fi
}

run_rc_command "$1"
