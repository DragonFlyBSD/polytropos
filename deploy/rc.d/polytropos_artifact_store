#!/bin/sh

# PROVIDE: polytropos_artifact_store
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown

#
# Receives build bundles from the dsynth hooks and writes them into the
# evidence tree. Loopback-only by default: nothing outside this host has
# any reason to post bundles.
#
# Add the following line to /etc/rc.conf to enable it:
# polytropos_artifact_store_enable="YES"
#
# Knobs (see /usr/local/etc/polytropos.conf for the shared ones):
# polytropos_artifact_store_enable (bool)  Set to "NO" by default.
# polytropos_home                  (str)   HOME for the service user.
# polytropos_cmd                   (str)   The dportsv3 command to run.
# polytropos_artifact_store_bind   (str)   Listen address. Default 127.0.0.1.
# polytropos_artifact_store_port   (str)   Listen port. Default 8788.
#

. /etc/rc.subr

name="polytropos_artifact_store"
rcvar=polytropos_artifact_store_enable
desc="Polytropos artifact store"

load_rc_config $name

: ${polytropos_artifact_store_enable:="NO"}
: ${polytropos_conf:="/usr/local/etc/polytropos.conf"}
[ -r "${polytropos_conf}" ] && . "${polytropos_conf}"

: ${polytropos_cmd:="/usr/local/bin/dportsv3"}
: ${polytropos_user:="polytropos"}
: ${polytropos_logs_root:="/build/synth/logs"}
: ${polytropos_home:="/var/db/polytropos"}
: ${polytropos_log_dir:="/var/log/polytropos"}
: ${polytropos_artifact_store_bind:="127.0.0.1"}
: ${polytropos_artifact_store_port:="8788"}

pidfile="/var/run/${name}.pid"
# The supervisor's own pid, which is a different process from the one in
# $pidfile. newsyslog signals THIS one to reopen the log after a rotation.
# Signalling the child instead — which is what daemon(8)'s own advice
# reads like — sends SIGUSR1 to a Python process, whose default
# disposition for it is to die. Verified on DragonFly: the service and
# its supervisor both went away.
supervisor_pidfile="/var/run/${name}.sup.pid"
logfile="${polytropos_log_dir}/artifact-store.log"

# DPORTSV3_NO_BOOTSTRAP: bin/dportsv3 will otherwise create and populate
# the venv on first run. A service start is the wrong moment to discover
# the network is down, so a deployment installs dependencies ahead of
# time and this stays off.
# HOME is not set by `daemon -u`: verified on DragonFly that a
# child dropped to an unprivileged user still inherits HOME=/root,
# which it cannot read. www/grist-core exports HOME for the same
# reason. Anything using Path.home() or a ~/.cache would fail in a
# way that points nowhere near this file.
polytropos_artifact_store_env="HOME=${polytropos_home} DPORTSV3_NO_BOOTSTRAP=1"

command="/usr/sbin/daemon"
command_args="-c -f -o ${logfile} -p ${pidfile} -P ${supervisor_pidfile} -t ${name} -u ${polytropos_user} \
    ${polytropos_cmd} artifact-store \
    --logs-root ${polytropos_logs_root} \
    --bind ${polytropos_artifact_store_bind} \
    --port ${polytropos_artifact_store_port}"

start_precmd="polytropos_artifact_store_prestart"

polytropos_artifact_store_prestart()
{
	if ! command -v "${polytropos_cmd}" >/dev/null 2>&1; then
		err 1 "${polytropos_cmd} not found; set polytropos_cmd — a packaged install has it in the prefix bindir, a checkout at bin/dportsv3"
	fi

	# The wrapper compares an install stamp against the venv on every
	# run, and DPORTSV3_NO_BOOTSTRAP=1 turns a mismatch into exit 1
	# rather than an install. Catch that here: otherwise the service
	# starts cleanly and fails at the first request instead.
	# Probed through the service's own subcommand rather than
	# --version: the install profile is part of the stamp string, so a
	# probe has to use the same argv shape the service will. This one
	# is the base profile either way, but saying so explicitly keeps it
	# correct if that ever changes (see the note in polytropos_tracker).
	if ! DPORTSV3_NO_BOOTSTRAP=1 "${polytropos_cmd}" \
	    artifact-store --help >/dev/null 2>&1; then
		err 1 "${polytropos_cmd} does not run; in a checkout the venv is stale or missing — try: ${polytropos_cmd} artifact-store --help"
	fi
	install -d -o "${polytropos_user}" -m 0755 "${polytropos_log_dir}" || return 1
	install -d -o "${polytropos_user}" -m 0755 "${polytropos_home}" || return 1
}

run_rc_command "$1"
