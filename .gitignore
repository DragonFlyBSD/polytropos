# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local config copies (only the .sample files are tracked)
config/agentic-policy.json
config/delivery.toml
config/delivery.token

# Local state: the tracker DB, queues, logs
*.db
*.db-wal
*.db-shm
*.log

# Beads. The Dolt database and its local archives are managed by Dolt, not git
# (.beads/.gitignore covers embeddeddolt/). The issue data itself is kept in
# git as .beads/issues.jsonl, auto-exported — see .beads/config.yaml.
.beads/backup/
